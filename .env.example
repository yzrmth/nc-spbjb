# =============================================================================
# Copy file ini ke ".env" lalu isi semua nilai "changeme_*" dengan password
# yang kuat (mis. `openssl rand -base64 24` atau password manager). JANGAN
# commit file ".env" ke git/VCS apapun.
# =============================================================================

# --- Postgres superuser --------------------------------------------------
# Dipakai HANYA oleh init-db/init-nextcloud-and-gis.sh untuk membuat user &
# database saat pertama kali container db jalan. Nextcloud maupun aplikasi
# GIS tidak pernah login pakai user ini.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=changeme_superuser_password

# --- Database Nextcloud (bersih, tanpa extension) -------------------------
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_PASSWORD=changeme_nextcloud_db_password

# --- Database GIS (PostGIS extension di-enable di sini saja) -------------
GIS_DB_NAME=gisdb
GIS_DB_USER=gisuser
GIS_DB_PASSWORD=changeme_gis_db_password

# --- Redis (cache + file locking) -----------------------------------------
REDIS_PASSWORD=changeme_redis_password

# --- Akun admin Nextcloud ---------------------------------------------------
# Hanya dipakai SEKALI untuk membuat akun admin pertama saat instalasi awal.
# Kalau container sudah pernah di-install, mengubah nilai ini tidak berefek
# lagi (ganti password lewat UI/occ user:resetpassword kalau perlu).
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=changeme_admin_password

# --- Trusted domains ---------------------------------------------------
# Space-separated (BUKAN koma). Wajib berisi semua host/IP yang dipakai
# untuk mengakses Nextcloud, kalau tidak akan muncul error "Access through
# untrusted domain".
# Sekarang (dev di laptop): cukup "localhost".
# Nanti (deploy di PC workstation): tambahkan IP LAN workstation, mis.
# "localhost 192.168.1.50". Saat pasang Cloudflare Tunnel, tambahkan domain
# publiknya juga.
NEXTCLOUD_TRUSTED_DOMAINS=localhost

# --- Trusted proxies ---------------------------------------------------
# Subnet Docker network "frontend" tempat Caddy berjalan (lihat docker-compose.yml,
# sudah di-fix ke 172.28.0.0/24). Ini memberitahu Nextcloud untuk mempercayai
# header X-Forwarded-Proto/X-Forwarded-For yang dikirim Caddy.
NEXTCLOUD_TRUSTED_PROXIES=172.28.0.0/24

# --- overwrite.cli.url ---------------------------------------------------
# URL yang dipakai Nextcloud saat dijalankan dari CLI/cron (bukan dari request
# browser), misalnya untuk link di notifikasi email.
# Harus SAMA dengan host di Caddyfile + port host Caddy di docker-compose.yml.
# Sekarang (dev di laptop, Caddy dipetakan ke 8443 karena port 80/443 dipakai
# XAMPP): https://localhost:8443
# Nanti (deploy di PC workstation, port 443 default balik dipakai):
# https://<IP-LAN-workstation>
# Fase public (Cloudflare Tunnel): ganti ke https://cloud.namadomainmu.com
NEXTCLOUD_OVERWRITE_CLI_URL=https://localhost:8443
